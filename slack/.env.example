# Slack app tokens. Never commit real values.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Fine-grained GitHub personal access token belonging to the trusted human owner.
# Repository permissions: Metadata read, Issues read/write, Pull requests read.
GITHUB_TOKEN=github_pat_your-token

# Comma-separated Agent Foundry repositories.
FOUNDRY_REPOS=eyal-hl/red-light-rng

# Only these Slack users may dispatch /challenge, /build, or /fix.
FOUNDRY_ALLOWED_SLACK_USER_IDS=U0BR9LR1U3S

# #builds in the Foundry workspace. Optional, but enables the activity feed and polling updates.
FOUNDRY_BUILDS_CHANNEL_ID=C0BQH9VSGMP

# Poll GitHub for autonomous PR/review/QA state changes. Minimum 30 seconds.
FOUNDRY_POLL_SECONDS=60

# Extra Slack-side guard: do not expose/allow Build until Disagreer has responded.
FOUNDRY_REQUIRE_CHALLENGE=true
